# ==============================================================================
# NepalReforms Tracker - Local Environment Configuration
# ==============================================================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_PLATFORM_URL=https://nepalreforms.com

# Email Service (Resend)
# Paste your new Resend API key here (starts with re_...)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@nepalreforms.com
RESEND_TO_EMAIL=tracker@nepalreforms.com

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Supabase (Optional / if syncing with platform)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
